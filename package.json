	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.8.1",
		"eslint-plugin-astro": "^3.1.0",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.10"
