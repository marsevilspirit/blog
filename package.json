{
	"name": "blog",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=26.5.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "pnpm run test:unit",
		"test:unit": "node --test tests/unit/*.test.ts",
		"test:i18n": "node --test scripts/verify-i18n.mjs",
		"check": "pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run build && pnpm run test:i18n"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "7.3.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"astro": "^7.3.5",
		"sharp": "^0.35.4",
		"smol-toml": "^1.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.11.0",
		"eslint-plugin-astro": "^3.2.1",
		"globals": "^17.12.0",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"typescript-eslint": "^8.70.1"
	}
}
