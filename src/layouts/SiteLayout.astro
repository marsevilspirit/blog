---
import type { ComponentProps } from 'astro/types';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../config';

type Props = ComponentProps<typeof BaseHead>;

const { lang, alternates = {} } = Astro.props;
---

<!doctype html>
<html lang={SITE[lang].htmlLang} data-theme="light">
	<head>
		<script is:inline>
			try {
				if (localStorage.getItem('color-theme') === 'dark') {
					document.documentElement.dataset.theme = 'dark';
				}
			} catch {
				// Storage can be disabled; keep the default light theme.
			}
			document.documentElement.classList.add('has-js');
		</script>
		<BaseHead {...Astro.props} />
	</head>
	<body>
		<Header lang={lang} alternates={alternates} />
		<main>
			<slot />
		</main>
		<Footer lang={lang} />
	</body>
</html>
