---
import FormattedDate from '../components/FormattedDate.astro';
import type { Lang } from '../config';
import type { Alternates } from '../i18n';
import SiteLayout from './SiteLayout.astro';

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	lang: Lang;
	alternates: Alternates;
}

const { title, description, pubDate, updatedDate, lang, alternates } = Astro.props;
---

<SiteLayout
	title={title}
	description={description}
	lang={lang}
	alternates={alternates}
	ogType="article"
	publishedTime={pubDate}
	modifiedTime={updatedDate}
>
	<article>
		<header class="post-header">
			<h1>{title}</h1>
			<div class="post-meta">
				<FormattedDate date={pubDate} lang={lang} />
				{
					updatedDate && (
						<span>
							{lang === 'zh' ? '更新于 ' : 'Updated '}
							<FormattedDate date={updatedDate} lang={lang} />
						</span>
					)
				}
			</div>
		</header>
		<div class="prose">
			<slot />
		</div>
	</article>
</SiteLayout>
