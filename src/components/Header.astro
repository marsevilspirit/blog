---
import { SITE, SITE_TITLE, type Lang } from '../config';
import { aboutPath, homePath, postsPath, type Alternates } from '../i18n';
import HeaderLink from './HeaderLink.astro';
import LanguageSelect from './LanguageSelect.astro';

interface Props {
	lang: Lang;
	alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const nav = SITE[lang].nav;
---

<header>
	<nav>
		<a class="site-title" href={homePath(lang)}>
			{SITE_TITLE}
		</a>
		<div class="internal-links">
			<HeaderLink href={postsPath(lang)}>{nav.posts}</HeaderLink>
			<HeaderLink href={aboutPath(lang)}>{nav.about}</HeaderLink>
			<LanguageSelect lang={lang} alternates={alternates} />
			<button class="theme-toggle" type="button">
				<span class="to-dark">{lang === 'zh' ? '深色' : 'Dark'}</span>
				<span class="to-light">{lang === 'zh' ? '浅色' : 'Light'}</span>
			</button>
		</div>
	</nav>
</header>
<script is:inline>
	document.querySelector('.theme-toggle')?.addEventListener('click', () => {
		const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = theme;
		try {
			localStorage.setItem('color-theme', theme);
		} catch {
			// The current page can still switch themes without storage.
		}
	});
</script>
<style>
	header {
		margin: 0 auto;
		width: var(--content-width);
		max-width: calc(100% - 2rem);
		padding: 2rem 0 1.25rem;
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}
	nav a {
		color: var(--text);
	}
	.site-title {
		font-size: 1.15rem;
		font-weight: 700;
	}
	.internal-links {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.theme-toggle {
		display: none;
		border: 1px solid var(--border);
		border-radius: 3px;
		padding: 0.05rem 0.35rem;
		background: var(--background);
		color: var(--text);
		font: inherit;
		font-size: 0.95rem;
		cursor: pointer;
	}
	:global(html.has-js) .theme-toggle {
		display: inline-block;
	}
	.to-light,
	:global(html[data-theme='dark']) .to-dark {
		display: none;
	}
	:global(html[data-theme='dark']) .to-light {
		display: inline;
	}
	.theme-toggle:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
</style>
